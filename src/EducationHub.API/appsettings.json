{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=EducationHub;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=False"
  },
  "Database": {
    "AutoMigrateOnStartup": true
  },
  "Jwt": {
    "Issuer": "EducationHub",
    "Audience": "EducationHub.Web"
  },
  "Auth": {
    "RateLimit": {
      "PermitLimit": 5,
      "Window": "00:05:00",
      "PhoneReset": { "PermitLimit": 10, "PerPhonePermitLimit": 3, "Window": "00:15:00" },
      "PublicRegistration": { "PermitLimit": 5, "Window": "01:00:00" },
      "Refresh": { "PermitLimit": 60, "Window": "00:01:00" }
    },
    "Email": {
      "FrontendBaseUrl": "http://localhost:4200"
    }
  },
  "FileStorage": {
    "RootPath": "App_Data/Files",
    "MaxTotalSizeBytes": 10737418240
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "WhatsApp": {
    "Provider": "None",
    "SendGuardianCredentials": true,
    "NotifyParents": true,
    "SendRegistrationConfirmation": false,
    "LoginUrl": "http://localhost:4200/login",
    "Meta": {
      "ApiVersion": "v21.0",
      "PhoneNumberId": "",
      "LanguageCode": "ar",
      "CredentialsTemplate": "",
      "NotificationTemplate": "",
      "PasswordResetTemplate": "",
      "RegistrationReceivedTemplate": ""
    }
  }
}