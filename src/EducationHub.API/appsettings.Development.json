{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=EducationHub_Dev01;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=False"
  },
  "Database": {
    "AutoMigrateOnStartup": true
  },
  "Jwt": {
    "Issuer": "EducationHub",
    "Audience": "EducationHub.Web"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  },
  "WhatsApp": {
    "Provider": "Log",
    "SendGuardianCredentials": true,
    "NotifyParents": true,
    "SendRegistrationConfirmation": true,
    "LoginUrl": "http://localhost:4200/login",
    "Meta": {
      "ApiVersion": "v21.0",
      "PhoneNumberId": "",
      "LanguageCode": "ar",
      "CredentialsTemplate": "",
      "NotificationTemplate": "",
      "PasswordResetTemplate": "",
      "RegistrationReceivedTemplate": ""
    }
  }
}
